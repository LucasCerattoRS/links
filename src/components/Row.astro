---
const { href, title, sub, primary, number } = Astro.props;
---
<li class={primary ? 'wa' : undefined}><a class={primary ? 'row primary' : 'row'} href={href}><span class="windowbar" aria-hidden="true"><span class="window-dots"></span><span class="window-label">LINK / {number}</span><i>↗</i></span><b>{title}</b><small>{sub}</small></a></li>
