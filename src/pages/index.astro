---
import Row from '../components/Row.astro';
import { sections, pix } from '../links';
import '../styles.css';
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Lucas Ceratto — links</title>
<meta name="description" content="Projetos, redes e contato do Lucas Ceratto Dagnese. Programação CNC e software que roda na sua máquina. Sem anúncios.">
<meta name="theme-color" content="#f4f3ec" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)">
<link rel="preload" href="/fonts/barlowcondensed-700.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<div class="sheet">
 <header class="stamp">
  <div class="mono" aria-hidden="true"><span>LC</span></div>
  <h1>Lucas<br>Ceratto</h1>
  <dl class="fields">
   <div><dt>Ofício</dt><dd>CNC moveleiro</dd></div>
   <div><dt>Também</dt><dd>Software local</dd></div>
   <div class="wide"><dt>Base</dt><dd>Rio Grande do Sul, Brasil</dd></div>
   <div class="wide"><dt>Regra da casa</dt><dd>Sem anúncio, sem rastreio, sem login</dd></div>
  </dl>
 </header>
 <svg class="path" viewBox="0 0 400 14" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 7 H120 L132 2 L144 12 L156 7 H400"/></svg>

 <main class="main">
  {sections.map((sec, sectionIndex) => (
    <section class="section">
      <h2><span class="section-index">{String(sectionIndex + 1).padStart(2, '0')}/</span>{sec.title}</h2>
      <ul class={sec.className ? `list ${sec.className}` : 'list'}>
        {sec.items.map((it, itemIndex) => <Row {...it} number={String(itemIndex + 1).padStart(2, '0')} />)}
      </ul>
    </section>
  ))}

  <section class="section">
   <h2><span class="section-index">04/</span>Apoio</h2>
   <ul class="list">
    <li class="wa"><button class="row" id="pix" type="button"><span class="windowbar" aria-hidden="true"><span class="window-dots"></span><span class="window-label">PIX / copiar chave</span><i>⧉</i></span><b>Apoiar com Pix</b><small id="pixmsg" aria-live="polite">Toque para copiar a chave</small></button></li>
   </ul>
  </section>
 </main>

 <footer><span>Feito à mão, 2026</span><span>Folha única · escala 1:1</span></footer>
</div>
<script is:inline define:vars={{ chave: pix.chave }}>
const k=chave,m=document.getElementById("pixmsg"),o=m.textContent;let t;
let tentativa=0;
const pix=document.getElementById("pix");
pix.onclick=async()=>{
 const atual=++tentativa;
 clearTimeout(t);
 try{await navigator.clipboard.writeText(k);if(atual!==tentativa)return;m.textContent="Chave copiada: "+k;t=setTimeout(()=>m.textContent=o,4000)}
 catch{if(atual!==tentativa)return;m.textContent="Chave Pix (telefone): "+k}};
</script>
</body>
</html>
